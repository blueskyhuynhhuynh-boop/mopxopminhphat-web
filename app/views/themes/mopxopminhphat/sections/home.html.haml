      .logo.desktop-only
        %img{:src => web_config("logo_url") , :alt => "logo", :loading => "lazy","data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "200"}
  - if (products = Product.tag("product-hot").limit(6).to_a).any?
    %section.secBlock1.secCate.py-md-5.py-4.overflow-hidden
      .container 
        %h2.home-title.text-center.wk-editable-text#Noibat-text{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true"} SẢN PHẨM NỔI BẬT
        .owl-carousel.owl-theme.Home3{"data-aos": "fade-left","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "400"}
          - products.each do |product|
            .item.my-1
              %a.d-block.img-block{ href: product_path(product), title: product.name }
                .dad-block-100.figure2
                  %img.child-block-scale.scale{ alt: product.name, src: product.image_url,:loading => "lazy" }
              .content-block 
                %a.d-block{ href: product_path(product), title: product.name }
                  %h3.text-1.fs18.fw-600= product.name.capitalize
                .tag-infor
                  - if product.prop( 'cach-nhiet').present?
                    .tag-bl Cách nhiệt
                  - if product.prop('chong-chay').present?
                    .tag-bl Chống cháy
                  - if product.prop( 'cach-am').present?
                    .tag-bl Cách âm
                  - if product.prop('tham-my').present?
                    .tag-bl Thẩm mỹ
                - if product.description.present?
                  %p.fs14.des= product.description
  - match = Category.find_by(slug: 'san-pham')
  - if match&.children&.any?
    - match.children.order(:display_order).each do |cate|
      %section.secBlock1.secCate.py-md-5.py-4.overflow-hidden
        .container 
          %h2.home-title.text-center{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true"}= cate.name.upcase
          - if cate.children.published.any?
            .list-name.d-flex.mb-md-4.justify-content-center{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "300"}
              - cate.children.published.each do | child |
                %a.fw-700{:href => category_path(child),:title => child.name}= child.name.upcase
          .owl-carousel.owl-theme.Home3{"data-aos": "fade-left","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "600"}
            - cate.products.limit(4).each do |product|
              .item.my-1
                %a.d-block.img-block{ href: product_path(product), title: product.name }
                  .dad-block-100.figure2
                    %img.child-block-scale.scale{ alt: product.name, src: product.image_url,:loading => "lazy" }
                .content-block 
                  %a.d-block{ href: product_path(product), title: product.name }
                    %h3.text-1.fs18.fw-600= product.name.capitalize
                  .tag-infor
                    - if product.prop( 'cach-nhiet').present?
                      .tag-bl Cách nhiệt
                    - if product.prop('chong-chay').present?
                      .tag-bl Chống cháy
                    - if product.prop( 'cach-am').present?
                      .tag-bl Cách âm
                    - if product.prop('tham-my').present?
                      .tag-bl Thẩm mỹ
                  - if product.description.present?
                    %p.fs14.des= product.description
          .about-btt.w-full.d-flex.justify-content-center
            %a.home-more.mt-4.fw-600{:href => category_path(cate),:title => cate.name} Xem tất cả
  %section.secVideo.py-md-5.py-4
    .container 
      %h2.home-title.text-center.wk-editable-text#home-secVideo-text1{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true"} VIDEO
      .owl-carousel.owl-theme.slideVideo{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "400"}
        - get_videos.each do |video|
          .item
            .specialVideoBlock.figure2
              .imgPart.figure3{:title => "xem video"}
                %img.imgVideo{:alt => "demo", :datalinkvideo => "https://www.youtube.com/embed/#{video.prop('id')}?autoplay=1", :src => "https://i1.ytimg.com/vi/#{video.prop('id')}/maxresdefault.jpg",:loading => "lazy"}/
                .content 
                  %p.fw-600.text-white.fs-18= video.name
                .playVideoBtn
                  %i.fa.fa-play
              .videoFloatBlock
                .btnHideVideo{:title => "close"}
                  %i.deleteBlock x
                .wrapVideo
                  .videoPart
                    %iframe{:allow => "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture", :allowfullscreen => "", :frameborder => "0", :height => "315", :title => "YouTube video player", :width => "560"}
                    %img.imgLoading{:alt => "loading", :src => "/tassets/images/img_loading_1.gif"}/
  - if (projectsHot = get_projects.joins(:tags).where(tags: { name: 'hot-project' }).published.limit(9).to_a).any?
    %section.secDuan.py-md-5.py-4
      .container.containerFix1300
        %h2.home-title.text-center.wk-editable-text#home-secDuan-text1{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "400"} DỰ ÁN TIÊU BIỂU
        .sub-text.text-center.mb-md-5.mb-4.wk-editable-html#home-secDuan-text2{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "800"} PANEL là giải pháp VÁCH - TRẦN - MÁI "CÁCH ÂM, CÁCH NHIỆT, CHỐNG CHÁY" hàng đầu tại Việt Nam. Sản phẩm được sử dụng cho các công trình nhà kho, nhà xưởng công nghệ cao, kho lạnh, phòng sạch, nhà máy...
        .desktop-only.position-relative
          .owl-carousel.owl-theme.slideDuan
            - projectsHot.each_slice(3) do |group|
              .item
                .row
                  - left = group[0]
                  - right1 = group[1]
                  - right2 = group[2]

                  .col-md-6
                    .left-block.spe-block.secBlock1
                      - if left
                        .spe-item.item{"data-aos": "fade","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "1000"}
                          %a.img-block{ href: project_path(left), title: left.name }
                            .dad-block-64.dad-fillter
                              %img.child-block-scale.scale{ src: left.image_url, alt: left.name, loading: "lazy" }
                          .content-block
                            %h3
                              %a{ href: project_path(left) }= left.name
                            .location
                              %span
                                %i.fa-solid.fa-location-dot
                              %p.fs14= left.prop('diachi')

                  .col-md-6
                    .right-block.secBlock1.spe-block
                      - if right1
                        .spe-item.item.mb-5{"data-aos": "fade","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "1000"}
                          %a.img-block{ href: project_path(right1), title: right1.name }
                            .dad-block-64.dad-fillter
                              %img.child-block-scale.scale{ src: right1.image_url, alt: right1.name, loading: "lazy" }
                          .content-block
                            %h3
                              %a{ href: project_path(right1) }= right1.name
                            .location
                              %span
                                %i.fa-solid.fa-location-dot
                              %p.fs14= right1.prop('diachi')
                      - if right2
                        .spe-item.item{"data-aos": "fade","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "1000"}
                          %a.img-block{ href: project_path(right2), title: right2.name }
                            .dad-block-64.dad-fillter
                              %img.child-block-scale.scale{ src: right2.image_url, alt: right2.name, loading: "lazy" }
                          .content-block
                            %h3
                              %a{ href: project_path(right2) }= right2.name
                            .location
                              %span
                                %i.fa-solid.fa-location-dot
                              %p.fs14= right2.prop('diachi')
            
          .Map
            %img{:src => "/tassets/images/mopxop/Chưa có tên (940 x 1440 px).webp",:alt => "map image",:loading => "lazy","data-aos": "fade","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "1000"}
        .mobile-only.secBlock1
          .owl-carousel.owl-theme.slideDuan
            - projectsHot.each do | project |
              .item{"data-aos": "fade","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "1000"}
                %a.img-block{:href => project_path(project),:title => project.name} 
                  .dad-block-64.dad-fillter
                    %img.child-block-scale.scale{:src => project.image_url,:alt => project.name,:loading => "lazy"}
                .content-block
                  %h3 
                    %a{:href => project_path(project),:title => project.name}= project.name
                  .location 
                    %span 
                      %i.fa-solid.fa-location-dot
                    %p.fs14= project.prop('diachi')
        .about-btt.w-full.d-flex.justify-content-center.flex-column.flex-md-row
          %a.home-more.mx-4.mt-4.fw-600.wk-editable-link#secDuan-link{:href => "/tin-tuc/",:title => ""} Xem tất cả
          %a.home-more.mx-4.mt-4.fw-600.wk-editable-link#secDuan-link1{:href => "/tin-tuc/",:title => ""} Liên hệ với chúng tôi
  - if (posts = Post.lastest.limit(4).to_a).any?
    %section.Main11.secBlock1.py-md-5.py-4
      .container.containerFix1300
        .left-main11 
          %h2.home-title.text-center.wk-editable-text#home-Main11-text1{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "4000"} Tin tức
          .row
            .col-lg-6.col-12
              - post = posts[0]
              .item-main-post.item-fil.item{"data-aos": "fade","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "800"}
                %a.img-block{:href => post_path(post),"aria-label" => post.name}
                  .dad-block-100.dad-fillter
                    %img.child-block-scale.scale{:alt => "hinh-anh" , :src => post.image_url, :loading => "lazy",:title => post.name,:decoding => "async"}/
                .content-block
                  .date.d-flex
                    .calendar-icon 
                      %i.fa-solid.fa-calendar-days
                    .days.pl-2
                      %p.text-day= post.created_at.localtime.strftime(' %d Tháng %m, %Y')
                  %h3
                    %a.d-block.title{:href => post_path(post),"aria-label" => post.name }= post.name.upcase
                  - if post.description.present?
                    %p.description.txt-name-prd= post.description
            .col-lg-6.col-12
              - posts.drop(1).each do |post|
                .item-sub-post.item-fil.d-flex.item{"data-aos": "fade-up","data-aos-duration": "1000","data-aos-once": "true","data-aos-delay": "1000"}
                  %a.img-block{:href => post_path(post),"aria-label" => post.name}
                    .dad-block-100.dad-fillter
                      %img.child-block-scale.scale{:alt => "hinh-anh" , :src =>  post.image_url, :loading => "lazy", :title => post.name,:decoding => "async"}/
                  .content-block
                    %p.fs14.text-day= post.created_at.localtime.strftime(' %d Tháng %m, %Y')
                    %h3
                      %a.d-block.title.fw-600{:href => post_path(post),"aria-label" => post.name}= post.name.upcase
                    %p.fs16.des= post.description
          .about-btt.w-full.d-flex.justify-content-center
            %a.home-more.mt-4.fw-600{:href => "/tin-tuc/",:title => ""} Xem tất cả
