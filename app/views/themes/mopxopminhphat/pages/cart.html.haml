// Giỏ hàng - cart page
= render_view "components/menu"

.cart-page{:style => "margin-top:120px; min-height:400px; padding: 40px 0;"}
  .container
    .row
      .col-lg-12.col-md-12.col-sm-12.col-12
        %h1{:style => "margin-bottom: 30px; font-size: 2rem; font-weight: 600;"} Giỏ hàng của bạn
        - if @cart.nil? || @cart.empty?
          .empty-cart{:style => "text-align: center; padding: 60px 20px;"}
            %p{:style => "font-size: 1.2rem; color: #666; margin-bottom: 20px;"}
              Giỏ hàng của bạn hiện đang trống.
            %p{:style => "margin-bottom: 30px;"}
              Vui lòng xem các sản phẩm của chúng tôi và thêm vào giỏ hàng.
            %a.btn.btn-primary{:href => root_path, :style => "display: inline-block; padding: 12px 30px; background: #1e3a8a; color: white; text-decoration: none; border-radius: 6px;"}
              Trở về trang chủ
            - if web_config('phone').present?
              %p{:style => "margin-top: 30px;"}
                Hoặc liên hệ trực tiếp:
                %strong= web_config('phone')
        - else
          .cart-items
            %table.table{:style => "width: 100%; border-collapse: collapse;"}
              %thead
                %tr
                  %th{:style => "text-align:left; padding:12px; border-bottom: 2px solid #e5e7eb;"} Sản phẩm
                  %th{:style => "text-align:center; padding:12px; border-bottom: 2px solid #e5e7eb;"} Số lượng
                  %th{:style => "text-align:right; padding:12px; border-bottom: 2px solid #e5e7eb;"} Đơn giá
                  %th{:style => "text-align:right; padding:12px; border-bottom: 2px solid #e5e7eb;"} Thành tiền
              %tbody
                - @cart.items.each do |item|
                  %tr
                    %td{:style => "padding:12px; border-bottom: 1px solid #f1f5f9;"}
                      - if item.product
                        = item.product.name
                      - else
                        Sản phẩm không xác định
                    %td{:style => "padding:12px; text-align:center; border-bottom: 1px solid #f1f5f9;"}
                      = item.try(:quantity) || 1
                    %td{:style => "padding:12px; text-align:right; border-bottom: 1px solid #f1f5f9;"}
                      = number_to_currency(item.try(:price) || (item.product && item.product.price) || 0, unit: 'đ', separator: ',', delimiter: '.', precision: 0, format: '%n %u')
                    %td{:style => "padding:12px; text-align:right; border-bottom: 1px solid #f1f5f9;"}
                      = number_to_currency(item.try(:total_price) || 0, unit: 'đ', separator: ',', delimiter: '.', precision: 0, format: '%n %u')
              %tfoot
                %tr
                  %td{:colspan => 3, :style => "padding:16px 12px; text-align:right; font-weight: 600; font-size: 1.1rem;"} Tổng cộng:
                  %td{:style => "padding:16px 12px; text-align:right; font-weight: 700; font-size: 1.2rem; color: #1e3a8a;"}
                    = number_to_currency(@cart.sub_total, unit: 'đ', separator: ',', delimiter: '.', precision: 0, format: '%n %u')
          .cart-actions{:style => "margin-top: 30px; text-align: right;"}
            %a.btn.btn-secondary{:href => root_path, :style => "display: inline-block; padding: 10px 24px; background: #e5e7eb; color: #1f2937; text-decoration: none; border-radius: 6px; margin-right: 10px;"}
              Tiếp tục mua hàng
            - if web_config('phone').present?
              %a.btn.btn-primary{:href => "tel:" + web_config('phone'), :style => "display: inline-block; padding: 10px 24px; background: #1e3a8a; color: white; text-decoration: none; border-radius: 6px;"}
                Liên hệ đặt hàng:
                = web_config('phone')

= render_view "components/footer"
